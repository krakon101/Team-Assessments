# ==========================================
# EDABIP Environment Configuration Example
# Copy this file to .env and adjust as needed
# ==========================================

# Application Settings
APP_NAME="EDABIP Authentication API"
APP_ENV=development
DEBUG=True

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./edabip.db

# Security & OTP Secrets
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
OTP_SECRET=change-this-to-a-very-secure-random-otp-secret-key-in-production

# OTP Security Policies
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_MAX_PER_HOUR=5

# Email Dispatcher Service
# Options for EMAIL_BACKEND: "console" (logs OTP to terminal) | "smtp" (sends live emails)
EMAIL_BACKEND=console

# SMTP Settings (Required only when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=no-reply@edabip.local
SMTP_USE_TLS=True
